# ============================================================
# KBook 配置 — 复制为 .env，改下面 4 个密码就能启动
# ============================================================
#   Windows: copy .env.example .env
#   Linux:   cp .env.example .env
# ============================================================
# ⚠️ .env 包含密码，切勿提交到 Git
# ============================================================

# ---- 必须修改 ⚠️ ----

# 数据库 root 密码（至少 16 位）
MYSQL_PASSWORD=

# Redis 密码（至少 16 位，不要和上面一样）
REDIS_PASSWORD=

# JWT 密钥（至少 32 位随机字符串，运行这行命令生成）
#   Windows: [Convert]::ToBase64String((1..32|%{[byte](Get-Random -Min 33 -Max 126)}))
#   Linux:   openssl rand -base64 32
JWT_SECRET=kbook-default-secret-key-must-be-at-least-256-bits-long-for-hs256

# 管理员登录密码（至少 12 位）
KBOOK_ADMIN_PASSWORD=


# ---- 数据库 / 中间件连接（可保持默认） ----
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=kbook-dev
MYSQL_USER=root

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=4

# Elasticsearch 地址（单节点: http://localhost:9200）
ES_URIS=http://localhost:9200

QDRANT_HOST=localhost
QDRANT_PORT=6334


# ---- 存储路径（可保持默认，相对于 deploy/docker/） ----
BOOK_PATH_EPUB=../data/books/epub
BOOK_PATH_PDF=../data/books/pdf
BOOK_PATH_TXT=../data/books/txt
BOOK_COVER_PATH=../data/covers
AVATAR_DIR=../data/avatars
CHAT_DIR=../data/chat
TTS_CACHE_DIR=../data/tts_cache

# AI 配置文件路径
AI_CONFIG_HOST=../ai-config.json


# ---- 可选修改 ----
APP_PORT_HOST=80
TZ=Asia/Shanghai
SPRING_PROFILE=prod

# 管理员邮箱
KBOOK_ADMIN_EMAIL=admin@kbook.com

# AI 视觉模型（OCR 用，不填则使用默认模型）
#AI_VISION_MODEL=gpt-4o
AI_VISION_TIMEOUT=600s
