# ============================================================
# KBook 配置模板 — 复制为 .env 后修改
#    Windows: copy .env.example .env
#    Linux:   cp .env.example .env
# ============================================================
# ⚠️ .env 包含密码和密钥！切勿提交到 Git！
#    Linux: chmod 600 .env（仅所有者可读写）
#    Windows: 确保文件不被意外分享
# ============================================================

# ============================================================
# 第一部分：数据库密码（所有密码必须修改！）
# ============================================================

# ---- MySQL 8.4 密码 ----
# ⚠️ 至少 16 位，大小写+数字+特殊字符混合
#    不要与 Redis 密码相同
MYSQL_PASSWORD=kbook2024

# ---- Redis 密码 ----
# ⚠️ 至少 16 位，不要与 MySQL 密码相同
REDIS_PASSWORD=kbook2024

# ============================================================
# 第二部分：JWT 认证密钥（最高安全优先级）
# ============================================================
# ⚠️ 必须修改！至少 32 字符的随机字符串！
#    Linux/Mac 生成: openssl rand -base64 32
#    Windows 生成 (PowerShell):
#      [Convert]::ToBase64String((1..32|%{[byte](Get-Random -Min 33 -Max 126)}))
#    密钥泄露 = 他人可伪造登录令牌！
JWT_SECRET=kbook-production-jwt-secret-must-be-at-least-256-bits-long

# ============================================================
# 第三部分：管理员账号（部署后第一时间修改密码）
# ============================================================
KBOOK_ADMIN_EMAIL=admin@kbook.com
# ⚠️ 至少 12 位，包含大小写+数字+特殊字符
KBOOK_ADMIN_PASSWORD=admin123456

# ============================================================
# 第四部分：AI 视觉模型配置
# ============================================================
# AI 模型供应商配置已迁移至数据库管理，
# 首次启动后请登录管理后台 → AI 配置管理 添加对话模型和嵌入模型。
#
# 以下仅保留视觉模型（PDF OCR）配置，
# 留空则自动使用数据库中启用的 CHAT-QA 模型。

AI_VISION_MODEL=
AI_VISION_TIMEOUT=600s

# ============================================================
# 第五部分：图书与文件目录（宿主机路径）
# ============================================================
# ⚠️ 这些是宿主机上的文件夹路径，容器内部路径固定。
#   将你的 EPUB/PDF/TXT 文件放入对应目录，
#   后端启动时会自动扫描。

# ---- 图书存放目录 ----
BOOK_PATH_EPUB_HOST=../data/books/epub
BOOK_PATH_PDF_HOST=../data/books/pdf
BOOK_PATH_TXT_HOST=../data/books/txt

# ---- 封面 / 上传 / 缓存 ----
COVER_PATH_HOST=../data/covers
AVATAR_DIR_HOST=../data/avatars
CHAT_DIR_HOST=../data/chat
TTS_CACHE_DIR_HOST=../data/tts_cache

# ---- AI 外部配置文件（直接编辑这个文件，然后点"重载"生效） ----
AI_CONFIG_HOST=../ai-config.json

# ============================================================
# 第六部分：端口映射（端口被占用时修改）
# ============================================================

# 前端访问端口（容器内 Nginx 监听 80，后端端口不对外暴露）
APP_PORT_HOST=80

# 基础设施端口（一般不需要改，除非被本机其他程序占用）
MYSQL_PORT_HOST=3306
REDIS_PORT_HOST=6379
ES_PORT_HOST=9200
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# ============================================================
# 第七部分：数据持久化目录（一般不需要改）
# ============================================================
MYSQL_DATA_DIR=../data/mysql
REDIS_DATA_DIR=../data/redis
ES_DATA_DIR=../data/es
QDRANT_DATA_DIR=../data/qdrant

# ES JVM 堆大小（不超过物理内存 50%）
ES_HEAP_SIZE=512m
# Redis 最大内存
REDIS_MAX_MEMORY=256mb

# ============================================================
# 第八部分：邮件服务（可选，留空则不启用）
# ============================================================
MAIL_USERNAME=
# ⚠️ QQ 邮箱使用授权码（16位），不是登录密码
#    在 QQ 邮箱 → 设置 → 账户 → 生成授权码
MAIL_PASSWORD=
NOTIFICATION_BASE_URL=https://book.keiskei.top

# ============================================================
# 第九部分：其他
# ============================================================
TZ=Asia/Shanghai
SPRING_PROFILE=prod
MYSQL_DB=kbook
REDIS_DB=4
