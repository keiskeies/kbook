# ============================================================
# KBook 单容器部署配置 — 完整版
# ============================================================
#   Windows: copy .env.example .env
#   Linux:   cp .env.example .env
# ============================================================
# ⚠️ .env 包含密码，切勿提交到 Git
# ============================================================
# 单容器模式需要自行准备 MySQL / Redis / ES / Qdrant 服务。
# 所有连接地址和密码在此文件中配置。
# ============================================================


# ============================================================
# 一、必须修改 ⚠️
# ============================================================

# ---- JWT 密钥（泄露 = 他人可伪造登录令牌） ----
# 至少 32 字符随机字符串
#   Linux:   openssl rand -base64 32
#   Windows: [Convert]::ToBase64String((1..32|%{[byte](Get-Random -Min 33 -Max 126)}))
JWT_SECRET=

# ---- MySQL ----
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=kbook
MYSQL_USER=root
# 至少 16 位，不要和 Redis 密码相同
MYSQL_PASSWORD=

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
# 至少 16 位
REDIS_PASSWORD=
REDIS_DB=4

# ---- 管理员 ----
# 至少 12 位
KBOOK_ADMIN_PASSWORD=


# ============================================================
# 二、基础设施连接
# ============================================================

# ---- Elasticsearch ----
ES_URIS=http://localhost:9200
ES_USERNAME=
ES_PASSWORD=

# ---- Qdrant 向量数据库 ----
QDRANT_HOST=localhost
QDRANT_PORT=6334
QDRANT_API_KEY=


# ============================================================
# 三、图书文件路径（宿主机真实路径）
# ============================================================
# Docker 会将这里配置的宿主机目录挂载到容器内 /data 下

BOOK_PATH_EPUB=../data/books/epub
BOOK_PATH_PDF=../data/books/pdf
BOOK_PATH_TXT=../data/books/txt
BOOK_COVER_PATH=../data/covers
AVATAR_DIR=../data/avatars
CHAT_DIR=../data/chat
TTS_CACHE_DIR=../data/tts_cache
AI_CONFIG_HOST=../ai-config.json


# ============================================================
# 四、服务资源与端口
# ============================================================

# 访问端口
APP_PORT_HOST=80

# ES JVM 堆内存（不超过物理内存一半，建议 1g 起步）
ES_HEAP_SIZE=1g

# Qdrant RAG 参数
QDRANT_CHUNK_SIZE=800
QDRANT_RAG_TOP_K=100


# ============================================================
# 五、其他
# ============================================================
#KBOOK_ADMIN_EMAIL=admin@kbook.com
#MAIL_USERNAME=
#MAIL_PASSWORD=
#NOTIFICATION_BASE_URL=http://localhost:8181
#AI_VISION_MODEL=
#TZ=Asia/Shanghai
#SPRING_PROFILE=prod

