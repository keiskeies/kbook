{
  "$schema": "https://raw.githubusercontent.com/nicholasgasior/tauri-config-schema/tauri-v2/schema.json",
  "productName": "KBook",
  "version": "0.1.0",
  "identifier": "com.kbook.desktop",
  "build": {
    "frontendDist": "../../frontend/dist",
    "beforeBuildCommand": "cd ../../frontend && npm run build -- --mode tauri"
  },
  "app": {
    "windows": [
      {
        "title": "KBook - 智能阅读平台",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "url": "/"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ]
  }
}
